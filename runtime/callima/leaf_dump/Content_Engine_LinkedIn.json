        "query": "INSERT INTO brann_actions (org_id, type, channel, payload, status, requires_hitl) VALUES ($1::uuid, 'social_post', 'linkedin', jsonb_build_object('text', $2::text, 'pilar', $3::text, 'tema', $4::text), 'pending', true) RETURNING id;",
